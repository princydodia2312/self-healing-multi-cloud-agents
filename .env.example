# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running the agent
#   cp .env.example .env
#
# DO NOT commit .env — it is listed in .gitignore.
# This file (.env.example) IS committed and serves as the canonical reference.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM backend the agents, the NL/Streamlit surface AND the RAG embeddings use:
#   gemini    → Google Gemini API — FREE tier, key from https://aistudio.google.com/apikey
#   openai    → OpenAI (paid)
#   anthropic → Anthropic (paid; uv sync --extra anthropic; embeddings stay on OpenAI)
# After switching provider, re-run `make ingest` (vectors from different models don't mix).
LLM_PROVIDER=gemini

# Agent model. Defaults per provider if unset: gemini-3.8-flash · gpt-4o · claude-sonnet-4-20250514
LLM_MODEL=gemini-3.8-flash

# Gemini only: second model used automatically when the main one is overloaded (503), times out
# (504) or runs out of free quota (429). Default gemini-3.6-flash; set to "none" to disable.
# LLM_FALLBACK_MODEL=gemini-3.6-flash

# Small model for the NL/Streamlit JSON extraction. Defaults: gemini-3.5-flash-lite · gpt-4o-mini
# NL_MODEL=gemini-3.5-flash-lite

# Embedding model (RAG). Defaults: gemini-embedding-2 · text-embedding-3-small — both 1536-dim
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIMENSIONS=1536

# Maximum seconds to wait for a single LLM call (default: 120)
LLM_TIMEOUT_SEC=120

# Retries on transient errors / rate limits (default: 6 for gemini, 1 otherwise)
# LLM_MAX_RETRIES=6

# Gemini (LLM_PROVIDER=gemini) — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=...your-gemini-key...

# OpenAI (LLM_PROVIDER=openai) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...your-openai-key...

# Only when LLM_PROVIDER=anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...


# ── Vector Store — Pinecone (RAG over knowledge_base/) ───────────────────────
# Create a free index at https://app.pinecone.io
# Index must use dimension=1536 (both text-embedding-3-small and gemini-embedding-2 @1536) and cosine metric
PINECONE_API_KEY=pcsk_...your-pinecone-key...
PINECONE_INDEX_NAME=unified-intelligence-fabric


# ── GitHub — CI/CD integration ────────────────────────────────────────────────
# Personal access token with repo + workflow scopes (the agent pushes generated
# artefacts and the Medic reads the deploy workflow's logs)
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...your-github-token...

# Repository the agent pushes generated artefacts to (owner/repo format)
# GitHub Actions sets this automatically; set it manually for local runs
GITHUB_REPOSITORY=your-org/your-repo


# ── AWS ──────────────────────────────────────────────────────────────────────
# Runtime credentials (the agent reads DB config from SSM at runtime)
AWS_ACCESS_KEY_ID=AKIA...your-aws-key-id...
AWS_SECRET_ACCESS_KEY=...your-aws-secret-key...
AWS_DEFAULT_REGION=eu-central-1

# Terraform variables for bootstrap/aws (make bootstrap-aws) — sensitive values only;
# non-sensitive variables have defaults in bootstrap/aws/variables.tf
TF_VAR_rds_allowed_cidrs='["your.ip.address/32"]'
# ARN of the IAM user/role the GitHub Actions pipeline runs as
TF_VAR_pipeline_iam_arn=arn:aws:iam::123456789012:user/your-pipeline-user


# ── PostgreSQL — AWS RDS source (eu_sales pipeline) ──────────────────────────
# Fallback only: cloud_get() reads SSM first, then .bootstrap_outputs.json, then these.
# Values come from `make bootstrap-aws` (see bootstrap/aws/outputs.tf).
POSTGRES_DB_HOST=your-rds-endpoint.rds.amazonaws.com
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=...your-rds-password...
POSTGRES_DB_NAME=sales_raw


# ── LangSmith tracing (optional — the agent's own run trace) ─────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=self-healing-big-data-pipeline
# LANGCHAIN_API_KEY=ls-...your-langsmith-key...


# ── Trino — query engine (used by the Streamlit "Trino SQL" tab) ─────────────
# Trino runs inside EKS; for local access:
#   kubectl port-forward svc/trino 8080:8080 -n analytics   → TRINO_HOST=localhost
TRINO_HOST=trino.analytics.svc.cluster.local
TRINO_PORT=8080
TRINO_USER=streamlit


# ── Prometheus — observability (used by the Streamlit "Observability" tab) ───
#   kubectl port-forward svc/prometheus 9090:9090 -n monitoring
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
